# Production example. Replace every placeholder; store as root:root mode 0600.
DATABASE_URL=postgres://glorynavy:REPLACE_PASSWORD@127.0.0.1:55433/glorynavy?sslmode=disable
HTTP_ADDR=10.233.53.209:18080
PUBLIC_ORIGIN=https://seat.kisectool.com
EVE_ENVIRONMENT=tranquility
MODULES=system,identity,eve,access,community,attendance,structures,exchange,fittings,skills,wallet,approval,sentry
# Welfare is not deployed yet. Back up and apply Goose 31 before appending ,welfare.
EVE_CLIENT_ID=REPLACE_CLIENT_ID
EVE_CLIENT_SECRET=REPLACE_CLIENT_SECRET
EVE_TOKEN_KEY=REPLACE_BASE64_32_BYTE_KEY
ESI_USER_AGENT=GloryNavy/0.1.0 (+https://seat.kisectool.com)
DB_MAX_CONNS=10
DB_SLOW_QUERY_MS=500
LOG_LEVEL=info
SDE_AUTO_UPDATE=true
SDE_CHECK_INTERVAL=6h
SDE_WORK_DIR=/var/lib/glorynavy/sde
# Private current-month WinterCo PAP service on the application host.
WINTERCO_PAP_URL=http://127.0.0.1:18770
WINTERCO_PAP_AUTH_FILE=/root/seat_pap/data/auth.json
# Official QQ bot (optional bootstrap). Configure the callback URL in the QQ
# open platform as PUBLIC_ORIGIN/api/v1/community/qq/official/webhook. After
# Goose 54, administrators can maintain these values from /account. Group
# OpenIDs are bot-scoped identifiers; do not use numeric QQ group numbers.
# QQ_BOT_APP_ID=
# QQ_BOT_APP_SECRET=
# QQ_BOT_API_BASE=https://api.bot.qq.com
# Optional bootstrap list; administrators can manage the persisted list from /account.
# QQ_BOT_GROUP_OPENIDS=group-openid-1,group-openid-2

# Optional EVE Sentry internal integration. The token is server-only.
# SENTRY_INTEGRATION_URL=https://sentry.example.com
# SENTRY_INTEGRATION_TOKEN=replace-with-a-32-character-or-longer-token
# Keep disabled until production pricing and evidence reconciliation are accepted.
# SENTRY_ALERT_CONSUMPTION_ENABLED=false
# Required only when enabling alert charging; do not use unreviewed defaults.
# SENTRY_ALERT_PRICE_VERSION=
# SENTRY_ALERT_UNIT_SECONDS=
# SENTRY_ALERT_UNIT_PRICE_MINOR=
# SENTRY_ALERT_MAX_GRANT_SECONDS=
# SENTRY_ALERT_GRANT_TTL=
