# Local development only. Copy to .env; never reuse this password in production.
# Linux production templates and instructions: deploy/seat.env.example, docs/deployment.md.
DATABASE_URL=postgres://glorynavy:glorynavy_dev@127.0.0.1:55432/glorynavy?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
DB_MAX_CONNS=10
# Application query duration warning; 0 disables. SQL text/arguments are never logged.
DB_SLOW_QUERY_MS=500
EVE_ENVIRONMENT=tranquility
# Compiled-in modules; dependencies must be explicitly enabled. Restart after changes.
# Optional local welfare first release: apply Goose 31, then append ,welfare; requires exchange.
MODULES=system,identity,eve,access,community,attendance,exchange,fittings,skills,wallet,market,approval,sentry
# HTTPS origin in production; local loopback HTTP is allowed. No trailing slash.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Create a confidential EVE application; callback = PUBLIC_ORIGIN/api/v1/eve/callback.
# Both empty means login is unavailable; never place the secret in VITE_* settings.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# Encrypts stored EVE tokens. Generate once: npm run auth:key. Back up securely.
# Required when eve and EVE login are configured. Never set VITE_EVE_TOKEN_KEY.
EVE_TOKEN_KEY=
# Set a real operator contact before deployment, e.g. GloryNavy/0.1.0 (contact: admin@example.com).
ESI_USER_AGENT=GloryNavy/0.1.0
# Public SDE updates run independently of EVE login when the eve module is enabled.
SDE_AUTO_UPDATE=true
SDE_CHECK_INTERVAL=6h
SDE_WORK_DIR=.local/sde
# Optional alliance PAP snapshot service. The auth file contains read_token
# and must stay outside the repository; current-month reads run every 30 min.
WINTERCO_PAP_URL=http://127.0.0.1:18770
WINTERCO_PAP_AUTH_FILE=/root/seat_pap/data/auth.json
# Official QQ open platform callback. The platform callback URL is
# PUBLIC_ORIGIN/api/v1/community/qq/official/webhook. These values are only
# bootstrap fallbacks; administrators can maintain them from /account after
# Goose 54. Never put these values in VITE_* variables.
# QQ_BOT_APP_ID=
# QQ_BOT_APP_SECRET=
# QQ_BOT_API_BASE=https://api.bot.qq.com
# Optional bootstrap list for automatic admission before an administrator saves groups in /account; numeric QQ group numbers are invalid.
# QQ_BOT_GROUP_OPENIDS=group-openid-1,group-openid-2

# Optional EVE Sentry internal integration. The URL is an HTTPS origin and the
# token is a server-only rotating credential; never expose either to the web UI.
# SENTRY_INTEGRATION_URL=https://sentry.example.com
# SENTRY_INTEGRATION_TOKEN=replace-with-a-32-character-or-longer-token
# Keep alert consumption disabled until the production rate/evidence acceptance
# is complete. Enabling this also requires exchange and eve in MODULES.
# SENTRY_ALERT_CONSUMPTION_ENABLED=false
# When alert charging is enabled, all pricing/grant fields below are required;
# there are intentionally no production defaults.
# SENTRY_ALERT_PRICE_VERSION=
# SENTRY_ALERT_UNIT_SECONDS=
# SENTRY_ALERT_UNIT_PRICE_MINOR=
# SENTRY_ALERT_MAX_GRANT_SECONDS=
# SENTRY_ALERT_GRANT_TTL=
